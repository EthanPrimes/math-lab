   "source": [
    "failing_numbers = set()\n",
    "for n in range(1, 32):\n",
    "    comment = \"'\" * n + \"k\" + \"'\" * n\n",
    "    try:\n",
    "        exec(comment)\n",
    "    except:\n",
    "        failing_numbers.add(n)\n",
    "\n",
    "print(failing_numbers)"
   ]
  }
